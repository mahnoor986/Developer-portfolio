# Postgres connection string (Neon in production; local Docker in dev: see docker-compose.yml)
DATABASE_URI=postgresql://portfolio:portfolio@127.0.0.1:5433/portfolio
# Long random string used to sign Payload auth tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# EmailJS identifiers and public account key (visible in browser tooling; never treat these as secrets)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_notification_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
NEXT_PUBLIC_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_autoreply_template_id
# EmailJS private key: server-side only; never prefix this with NEXT_PUBLIC_
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
# Sender email configured and verified for the EmailJS service
EMAILJS_FROM_ADDRESS=your_verified_sender@example.com
# Vercel Blob token for uploads (optional in dev; local filesystem is used without it)
BLOB_READ_WRITE_TOKEN=
# Secret for the /api/preview route (Live Preview / draft mode)
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE
