# Postgres connection string (Neon in production; local Docker in dev: see docker-compose.yml)
DATABASE_URI=postgresql://portfolio:portfolio@127.0.0.1:5433/portfolio
# Long random string used to sign Payload auth tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Resend API key for email alerts + auto-replies (optional in dev)
RESEND_API_KEY=
# Sender for emails (optional; these are the defaults). onboarding@resend.dev works without a domain but can
# only email the address you signed up to Resend with. After verifying your own domain, use an address on it.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Mahnoor Portfolio
# Vercel Blob token for uploads (optional in dev; local filesystem is used without it)
BLOB_READ_WRITE_TOKEN=
# Secret for the /api/preview route (Live Preview / draft mode)
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE
